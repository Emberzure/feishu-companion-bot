# 复制成 .env 再填：cp .env.example .env && chmod 600 .env
#
# 注意：.env 已经被 .gitignore 挡住，不会提交。不要手动 git add 它。

# ── 飞书应用凭证（必填）─────────────────────────────
# 开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 模型 API Key（必填）────────────────────────────
DEEPSEEK_API_KEY=

# ── 以下都有默认值，不写也能跑 ──────────────────────

# 人设文件路径。默认读项目根目录的 persona.md
# PERSONA_PATH=./persona.md

# 主人是谁（飞书 open_id，ou_ 开头）。
# 留空 = 自动认领第一个跟机器人说话的人，记到 data/owner.json
# OWNER_OPEN_ID=

# 「记忆检索员」开关。设成 0 关掉 —— 更快、不额外花钱，
# 但绕弯的说法就匹配不上旧事了（比如用「又去老地方了」戳不到记着「常去的那家店」那条）
# RECALL_LLM=1

# 主动发言：静默满多少小时才考虑
# PROACTIVE_AFTER_HOURS=2
# 主动发言：每天最多几条（每天会先随机抽一个 0 到上限的额度）
# PROACTIVE_DAILY_CAP=5
# 两次主动发言之间至少隔多少小时
# PROACTIVE_MIN_GAP_HOURS=0.75
# 免打扰时段（只约束主动发言，你找它它一定回）
# QUIET_FROM=1
# QUIET_TO=8

# 角色自己的生活：off / light
# off   —— 提示词里不出现「她自己的生活」，也不写日记
# light —— 默认。此刻在做什么、今天什么天气、每天最多两篇自己的日记
# （代码里还认 full，目前和 light 一样，留给以后扩展）
# LIFE=light

# ── 语音条（可选）─────────────────────────────────
# 不填 DASHSCOPE_API_KEY 就一直是文字，不影响聊天。
# 还需要系统里有 ffmpeg / ffprobe（Arch: pacman -S ffmpeg）。
# 第一次用先跑 tools/test-tts.mjs 复刻一个音色。
# DASHSCOPE_API_KEY=
# TTS_MODEL=qwen-audio-3.1-tts-flash
# TTS_RATE=1.2
# QWEN_TTS_VOICE_ID=
# auto = 模型觉得该发语音才发；off = 不发；always = 每条都发（调试用）
# VOICE_MODE=auto
# VOICE_MAX_CHARS=80
# 0 = 不限条数（仍然计数）
# VOICE_DAILY_CAP=0
