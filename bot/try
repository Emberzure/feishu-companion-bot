#!/usr/bin/env bash
# 调试台
#
#   ./try                     跑几个预设场景
#   ./try "他说的话"           试一句
#   ./try -m "他说的话"        带上长期记忆试一句（会打印她想起了什么）
#   ./try --voice "他说的话"   带上「语音/打字」说明，看她会不会在开头写 <<v>>
#   ./try --life              看看她此刻在过什么日子（不调主模型、不写库）
#   ./try --diary             生成一篇今天的日记（只打印，不落库）
#   ./try -f 文件.txt          从文件读一段对话来试（每行一条，u:/a: 开头区分是谁）
#   ./try --at "2026-01-01 03:00" "在吗"   假装现在是某个时刻
#
# 它真调 DeepSeek，但【只读 data/】—— 不改任何东西，也不影响正在跑的 bot，
# 所以 bot 在跑的时候也能用。
#
# 改完人设或语气，先用这个试，满意了再 ./reload。
# ⚠️ 别在真聊天里试改动 —— 坏回复会进记忆，她会照着自己学。

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1
exec node try.mjs "$@"
