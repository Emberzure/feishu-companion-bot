#!/usr/bin/env bash
# 设置飞书应用凭证
#
#   ./set-feishu-secret          设置或更新 App ID / App Secret
#   ./set-feishu-secret --clear  删掉
#
# App Secret 等于机器人的密码。所以让你自己输、不回显、不进 shell 历史 ——
# 别用 `echo 'secret' >> .env` 那种写法，那会存进 ~/.bash_history。
# 写完把 .env 权限设成 600。

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

ENV_FILE=".env"
K_ID="FEISHU_APP_ID"
K_SECRET="FEISHU_APP_SECRET"

if [ "${1:-}" = "--clear" ]; then
  for k in "$K_ID" "$K_SECRET"; do
    if grep -q "^${k}=" "$ENV_FILE" 2>/dev/null; then
      grep -v "^${k}=" "$ENV_FILE" > "$ENV_FILE.tmp"; mv "$ENV_FILE.tmp" "$ENV_FILE"
      echo "✔ 已删除 $k"
    fi
  done
  chmod 600 "$ENV_FILE" 2>/dev/null || true
  exit 0
fi

if ! [ -t 0 ]; then
  echo "✗ 这个脚本要交互输入，请在终端里直接运行，不要用管道。"
  exit 1
fi

echo "飞书开发者后台 → 你的应用 → 「凭证与基础信息」里有两个值。"
echo

read -rp  "App ID（cli_ 开头，直接回车则沿用现有值）: " APP_ID
read -rsp "App Secret（输入时不显示）: " APP_SECRET
echo

if [ -z "$APP_SECRET" ]; then
  echo "✗ App Secret 是空的，什么都没改。"
  exit 1
fi

touch "$ENV_FILE"
if [ -n "$APP_ID" ]; then
  grep -v "^${K_ID}=" "$ENV_FILE" > "$ENV_FILE.tmp" 2>/dev/null || true
  mv "$ENV_FILE.tmp" "$ENV_FILE" 2>/dev/null || true
  echo "${K_ID}=${APP_ID}" >> "$ENV_FILE"
  echo "✔ 已写入 $K_ID = ${APP_ID}"
fi

grep -v "^${K_SECRET}=" "$ENV_FILE" > "$ENV_FILE.tmp" 2>/dev/null || true
mv "$ENV_FILE.tmp" "$ENV_FILE" 2>/dev/null || true
echo "${K_SECRET}=${APP_SECRET}" >> "$ENV_FILE"
chmod 600 "$ENV_FILE"
unset APP_SECRET

echo "✔ 已写入 $K_SECRET（共 ${#APP_ID} / $(grep -c "^${K_SECRET}=" "$ENV_FILE") 行，内容不显示）"
echo "  .env 权限已设为 600"
